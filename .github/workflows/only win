name: Windows Only 3.13 3.14 CUDA

on: workflow_dispatch

jobs:
  build:
    runs-on: windows-latest
    strategy:
      matrix:
        py: ['3.13', '3.14.0-alpha - 3.14.0']
        backend: [cpu, cuda124, cuda118]
    steps:
      - uses: actions/checkout@v4
        with:
          repository: abetlen/llama-cpp-python
          submodules: recursive
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.py }}
          allow-prereleases: true
      - uses: Jimver/cuda-toolkit@v0.2.16
        if: contains(matrix.backend, 'cuda')
        with:
          cuda: ${{ contains(matrix.backend, '124') && '12.4.0' || '11.8.0' }}
      - run: pip install uv
      - run: |
          uv venv
          uv pip install build setuptools scikit-build-core cmake ninja
      - run: uv run python -m build --wheel --no-isolation
        env:
          CMAKE_ARGS: ${{ contains(matrix.backend, 'cuda') && '-DLLAMA_CUDA=ON' || '-DLLAMA_CUDA=OFF' }} -DLLAMA_AVX2=ON
      - uses: actions/upload-artifact@v4
        with:
          name: py${{ matrix.py }}-${{ matrix.backend }}
          path: dist/*.whl
