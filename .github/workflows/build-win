name: Build Windows Wheels

on:
  workflow_dispatch:
    inputs:
      version:
        description: 'llama-cpp-python version (tag or commit)'
        required: false
        default: 'main'
        type: string

jobs:
  build-windows-cpu:
    name: Windows CPU - Python ${{ matrix.python-version }}
    runs-on: windows-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ['3.9', '3.10', '3.11', '3.12', '3.13', '3.14.0-alpha - 3.14.0']
        include:
          - python-version: '3.14.0-alpha - 3.14.0'
            tag: '3.14'
    
    steps:
      - uses: actions/checkout@v4
        with:
          repository: abetlen/llama-cpp-python
          ref: ${{ github.event.inputs.version || 'main' }}
          submodules: recursive

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          allow-prereleases: true

      - run: pip install uv

      - run: |
          uv venv
          uv pip install build wheel setuptools scikit-build-core cmake ninja

      - run: uv run python -m build --wheel --no-isolation
        env:
          CMAKE_ARGS: "-DLLAMA_AVX2=ON -DLLAMA_CUDA=OFF"

      - uses: actions/upload-artifact@v4
        with:
          name: windows-cpu-py${{ matrix.tag || matrix.python-version }}
          path: dist/*.whl

  build-windows-cuda:
    name: Windows CUDA ${{ matrix.cuda }} - Python ${{ matrix.python-version }}
    runs-on: windows-latest
    strategy:
      fail-fast: false
      matrix:
        python-version: ['3.9', '3.10', '3.11', '3.12', '3.13', '3.14.0-alpha - 3.14.0']
        cuda: ['12.4', '11.8']
        include:
          - python-version: '3.14.0-alpha - 3.14.0'
            tag: '3.14'
          - cuda: '12.4'
            cuda-pkg: '12.4.0'
          - cuda: '11.8'
            cuda-pkg: '11.8.0'
    
    steps:
      - uses: actions/checkout@v4
        with:
          repository: abetlen/llama-cpp-python
          ref: ${{ github.event.inputs.version || 'main' }}
          submodules: recursive

      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
          allow-prereleases: true

      - uses: Jimver/cuda-toolkit@v0.2.16
        with:
          cuda: ${{ matrix.cuda-pkg }}

      - run: pip install uv

      - run: |
          uv venv
          uv pip install build wheel setuptools scikit-build-core cmake ninja

      - run: uv run python -m build --wheel --no-isolation
        env:
          CMAKE_ARGS: "-DLLAMA_CUDA=ON -DLLAMA_AVX2=ON"

      - run: |
          cd dist
          ren *.whl *cuda${{ matrix.cuda }}.whl

      - uses: actions/upload-artifact@v4
        with:
          name: windows-cuda${{ matrix.cuda }}-py${{ matrix.tag || matrix.python-version }}
          path: dist/*.whl
